# Copy to .env and fill in ANTHROPIC_API_KEY. Everything else works as-is.

# Required from Day 2 onward (the AI analyst). Day 1 runs without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Infrastructure. These hostnames resolve inside the Compose network.
DATABASE_URL=postgresql://threatgraph:threatgraph@postgres:5432/threatgraph
REDIS_URL=redis://redis:6379/0

# DEBUG logs every tool call the analyst makes.
LOG_LEVEL=INFO

# Bounds on the agent loop, so a looping model cannot occupy a worker
# indefinitely or silently double the API spend.
ANALYST_MAX_ITERATIONS=10
ANALYST_TIMEOUT_SECONDS=180

# How long a task may sit unacknowledged before another worker reclaims it.
# Enrichment finishes in seconds; an agentic Claude loop routinely runs past
# thirty, so the two stages get different thresholds.
RECLAIM_IDLE_ENRICH_MS=30000
RECLAIM_IDLE_ANALYZE_MS=300000

# Submissions per client per minute.
RATE_LIMIT_PER_MINUTE=30

# Load the demo investigations on first start (Day 3).
SEED_DEMO_DATA=true

# Which analyst client to use: auto | anthropic | stub
# auto = Claude when ANTHROPIC_API_KEY is set, scripted client otherwise.
ANALYST_CLIENT=auto
ANALYST_EFFORT=medium
